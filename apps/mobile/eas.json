{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal" },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_SUPABASE_URL": "REPLACE", "EXPO_PUBLIC_SUPABASE_ANON_KEY": "REPLACE", "EXPO_PUBLIC_SITE_URL": "https://YOUR-DOMAIN.com" }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_SUPABASE_URL": "REPLACE", "EXPO_PUBLIC_SUPABASE_ANON_KEY": "REPLACE", "EXPO_PUBLIC_SITE_URL": "https://YOUR-DOMAIN.com" }
    }
  },
  "submit": {
    "production": {
      "android": { "serviceAccountKeyPath": "./google-play-service-account.json", "track": "internal", "releaseStatus": "draft" }
    }
  }
}
